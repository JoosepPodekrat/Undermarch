# Unity core
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# ProjectSettings
# Keep ProjectSettings tracked (esp. ProjectVersion.txt, Input, Graphics, etc.)
# Optional: ignore boot.config as it's generated per build in some workflows
ProjectSettings/boot.config

# Memory/recordings (large and/or sensitive)
[Mm]emoryCaptures/
[Rr]ecordings/

# Addressables (default ignores; keep settings/group assets tracked)
# These are generated per-content-build and safe to ignore
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Autogenerated JetBrains Rider plugin (don’t commit)
/[Aa]ssets/Plugins/Editor/JetBrains*
# Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache
.vs/
# Gradle cache
.gradle/

# IDE/editor junk
.idea/
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Blender backups (Unity can import .blend directly; .blend1 is a local backup)
/*.blend1
*.blend1.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Build artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Custom .NET build artifacts (for standalone simulation testing)
/bin/
/TempCompile/
dotnet-install.sh
simulation_files.txt
